# 复制为 .env 后填写；.env 已被 .gitignore 排除，不会进入仓库。
# 不要把真实 key 写进 .env.example。
COMMAND_CODE_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# 可选：支持图片输入的模型，例如 gpt-4o / qwen-vl-max
AI_VISION_MODEL=
# 百度网盘 OAuth（仅本地服务/桌面版读取，不要提交真实值）
BAIDU_APP_KEY=
BAIDU_SECRET_KEY=
BAIDU_REDIRECT_URI=http://127.0.0.1:4399/oauth/baidu/callback

# PORT=4321
# HOST=127.0.0.1
